@page
@model Marketplace.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="container py-4">
    <section class="marketplace-card marketplace-hero login-hero p-4 p-md-5 mb-4">
        <div class="marketplace-eyebrow mb-2">
            <i class="bi bi-shield-lock me-1"></i> Acesso seguro
        </div>
        <h1 class="h2 mb-2">Entrar no MarketPlace</h1>
        <p class="text-muted mb-0">Use seu login para acessar pedidos e ferramentas do backoffice.</p>
    </section>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <section class="marketplace-card login-card p-4 p-md-5">
                <div class="login-avatar mb-4">
                    <i class="bi bi-person-fill"></i>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" data-loading-text="Entrando...">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                    </button>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
