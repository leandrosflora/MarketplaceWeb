@page "/admin/carriers"
@model Marketplace.Web.Pages.Admin.Carriers.IndexModel
@{
    ViewData["Title"] = "Admin - Transportadoras";
}

@section Styles {
    @await Html.PartialAsync("_DataTablesAssets", "styles")
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="d-flex align-items-center justify-content-end mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCarrierModal">
        <i class="bi bi-plus-lg me-1"></i> Novo
    </button>
</div>

<table id="carriers-table" class="table table-sm w-100">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Status</th>
            <th>Validação em tempo real</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var carrier in Model.Carriers)
        {
            <tr>
                <td>@carrier.Code</td>
                <td>@carrier.Name</td>
                <td>@carrier.Status</td>
                <td>@carrier.RequiresRealTimeValidation</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Carriers/ServiceLevels" asp-route-carrierCode="@carrier.Code">Service Levels</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Carriers/Lanes" asp-route-carrierCode="@carrier.Code">Lanes</a>
                    <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                        <input type="hidden" name="carrierCode" value="@carrier.Code" />
                        <select name="status" class="form-select form-select-sm d-inline-block w-auto">
                            <option value="Active">Active</option>
                            <option value="Degraded">Degraded</option>
                            <option value="Suspended">Suspended</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Alterar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createCarrierModal" tabindex="-1" aria-labelledby="createCarrierModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createCarrierModalLabel">Criar Transportadora</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Código</label>
                            <input class="form-control" asp-for="CreateInput.Code" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Nome</label>
                            <input class="form-control" asp-for="CreateInput.Name" required />
                        </div>
                        <div class="col-12 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.RequiresRealTimeValidation" />
                            <label class="form-check-label" asp-for="CreateInput.RequiresRealTimeValidation">Requer validação em tempo real</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Criar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesAssets", "scripts")
    <script>
        $(function () {
            $('#carriers-table').DataTable({
                columnDefs: [{ targets: -1, orderable: false }],
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rt<"d-flex justify-content-between align-items-center mt-2"lp>',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });

            @if (Model.ShowCreateModal)
            {
                <text>
                var createCarrierModal = new bootstrap.Modal(document.getElementById('createCarrierModal'));
                createCarrierModal.show();
                </text>
            }
        });
    </script>
}
