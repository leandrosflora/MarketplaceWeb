@page "/admin/fulfillment-centers"
@model Marketplace.Web.Pages.Admin.FulfillmentCenters.IndexModel
@{
    ViewData["Title"] = "Admin - Fulfillment Centers";
}

@section Styles {
    @await Html.PartialAsync("_DataTablesAssets", "styles")
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="d-flex align-items-center justify-content-end mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createFulfillmentCenterModal">
        <i class="bi bi-plus-lg me-1"></i> Novo
    </button>
</div>

<table id="fulfillment-centers-table" class="table table-sm w-100">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Região</th>
            <th>Timezone</th>
            <th>Status</th>
            <th class="text-end">Peso Máx (kg)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var center in Model.Centers)
        {
            <tr>
                <td>@center.Code</td>
                <td>@center.Name</td>
                <td>@center.Region</td>
                <td>@center.TimeZoneId</td>
                <td>@center.Status</td>
                <td class="text-end" data-order="@center.MaximumWeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture)">@center.MaximumWeightKg</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/FulfillmentCenters/Capacity" asp-route-fulfillmentCenterId="@center.Id">Capacidade</a>
                    <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                        <input type="hidden" name="fulfillmentCenterId" value="@center.Id" />
                        <select name="status" class="form-select form-select-sm d-inline-block w-auto">
                            <option value="Active">Active</option>
                            <option value="TemporarilyUnavailable">TemporarilyUnavailable</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Alterar status</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createFulfillmentCenterModal" tabindex="-1" aria-labelledby="createFulfillmentCenterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createFulfillmentCenterModalLabel">Criar Fulfillment Center</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Código</label>
                            <input class="form-control" asp-for="CreateInput.Code" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Nome</label>
                            <input class="form-control" asp-for="CreateInput.Name" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Região</label>
                            <input class="form-control" asp-for="CreateInput.Region" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Timezone</label>
                            <input class="form-control" asp-for="CreateInput.TimeZoneId" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Peso máx (kg)</label>
                            <input class="form-control" type="number" step="0.001" min="0.001" asp-for="CreateInput.MaximumWeightKg" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Peso cúbico máx (kg)</label>
                            <input class="form-control" type="number" step="0.001" min="0.001" asp-for="CreateInput.MaximumCubicWeightKg" required />
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.SupportsFragileItems" />
                            <label class="form-check-label" asp-for="CreateInput.SupportsFragileItems">Aceita frágeis</label>
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.SupportsRestrictedItems" />
                            <label class="form-check-label" asp-for="CreateInput.SupportsRestrictedItems">Aceita restritos</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Criar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesAssets", "scripts")
    <script>
        $(function () {
            $('#fulfillment-centers-table').DataTable({
                columnDefs: [{ targets: -1, orderable: false }],
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rt<"d-flex justify-content-between align-items-center mt-2"lp>',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });

            @if (Model.ShowCreateModal)
            {
                <text>
                var createFulfillmentCenterModal = new bootstrap.Modal(document.getElementById('createFulfillmentCenterModal'));
                createFulfillmentCenterModal.show();
                </text>
            }
        });
    </script>
}
