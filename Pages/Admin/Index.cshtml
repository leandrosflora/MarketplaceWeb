@page "/admin"
@model Marketplace.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}

<div class="container py-4">
    <p class="text-uppercase text-muted fw-semibold mb-1">Administração</p>
    <h1 class="h3 mb-4">Backoffice</h1>

    <p class="text-muted">
        Área administrativa para gestão de dados mestre (produtos, estoque, fulfillment,
        malha logística, transportadoras e pricing) via <code>MarketplaceAdmin.Bff</code>.
        As telas de cada domínio são adicionadas incrementalmente — veja
        <code>openspec/changes/admin-backoffice/tasks.md</code> para o roteiro.
    </p>

    <ul class="list-unstyled">
        <li><a asp-page="/Admin/Products/Index">Produtos Ofertados</a></li>
    </ul>
</div>
