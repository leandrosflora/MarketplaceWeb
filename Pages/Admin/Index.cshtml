@page "/admin"
@model Marketplace.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}

<div class="container py-4">
    <p class="text-uppercase text-muted fw-semibold mb-1">Administração</p>
    <h1 class="h3 mb-4">Backoffice</h1>

    <p class="text-muted">
        Área administrativa para gestão de dados mestre (produtos, estoque, fulfillment,
        malha logística, transportadoras e pricing) via <code>MarketplaceAdmin.Bff</code>.
        As telas de cada domínio são adicionadas incrementalmente — veja
        <code>openspec/changes/admin-backoffice/tasks.md</code> para o roteiro.
    </p>

    <ul class="list-unstyled">
        <li><a asp-page="/Admin/Products/Index">Produtos Ofertados</a></li>
        <li><a asp-page="/Admin/Inventory/Index">Estoque</a></li>
        <li><a asp-page="/Admin/FulfillmentCenters/Index">Fulfillment Centers</a></li>
        <li><a asp-page="/Admin/Network/Nodes">Nós Logísticos</a></li>
        <li><a asp-page="/Admin/Network/Lanes">Lanes / Rotas</a></li>
        <li><a asp-page="/Admin/Carriers/Index">Transportadoras</a></li>
        <li><a asp-page="/Admin/Pricing/RateCards">Rate Cards</a></li>
        <li><a asp-page="/Admin/Pricing/SubsidyRules">Subsídios E Promoções</a></li>
        <li><a asp-page="/Admin/Simulators/ShippingPromise">Simular Frete</a></li>
        <li><a asp-page="/Admin/Orders/Index">Pedidos</a></li>
        <li><a asp-page="/Admin/Shipments/Index">Shipments</a></li>
        <li><a asp-page="/Admin/Tracking/Events">Inserir Evento de Tracking</a></li>
        <li><a asp-page="/Admin/Audit/Index">Trilha de Auditoria</a></li>
    </ul>
</div>
