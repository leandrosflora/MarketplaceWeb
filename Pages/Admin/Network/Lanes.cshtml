@page "/admin/network/lanes"
@model Marketplace.Web.Pages.Admin.Network.LanesModel
@{
    ViewData["Title"] = "Admin - Lanes / Rotas";
}

@section Styles {
    @await Html.PartialAsync("_DataTablesAssets", "styles")
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="d-flex align-items-center justify-content-end mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createLaneModal">
        <i class="bi bi-plus-lg me-1"></i> Novo
    </button>
</div>

<table id="lanes-table" class="table table-sm w-100">
    <thead>
        <tr>
            <th>Origem</th>
            <th>Destino</th>
            <th>Carrier</th>
            <th>Service Level</th>
            <th>Modo</th>
            <th class="text-end">Trânsito (min)</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lane in Model.Lanes)
        {
            <tr>
                <td class="small">@lane.OriginNodeId</td>
                <td class="small">@lane.DestinationNodeId</td>
                <td>@lane.CarrierCode</td>
                <td>@lane.ServiceLevelCode</td>
                <td>@lane.Mode</td>
                <td class="text-end">@lane.TransitMinutes</td>
                <td>@lane.Status</td>
                <td>
                    <form method="post" asp-page-handler="ChangeStatus" class="d-inline">
                        <input type="hidden" name="laneId" value="@lane.Id" />
                        <input type="hidden" name="region" value="Brasil Sudeste" />
                        <select name="status" class="form-select form-select-sm d-inline-block w-auto">
                            <option value="Active">Active</option>
                            <option value="Suspended">Suspended</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Alterar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createLaneModal" tabindex="-1" aria-labelledby="createLaneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createLaneModalLabel">Criar Lane</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Origem (Node ID)</label>
                            <input class="form-control" asp-for="CreateInput.OriginNodeId" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Destino (Node ID)</label>
                            <input class="form-control" asp-for="CreateInput.DestinationNodeId" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Carrier Code</label>
                            <input class="form-control" asp-for="CreateInput.CarrierCode" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Service Level Code</label>
                            <input class="form-control" asp-for="CreateInput.ServiceLevelCode" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Modo</label>
                            <select class="form-select" asp-for="CreateInput.Mode">
                                <option value="Road">Road</option>
                                <option value="Air">Air</option>
                                <option value="Rail">Rail</option>
                                <option value="InternalTransfer">InternalTransfer</option>
                                <option value="LastMile">LastMile</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Trânsito (min)</label>
                            <input class="form-control" type="number" min="1" asp-for="CreateInput.TransitMinutes" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Peso máx (kg)</label>
                            <input class="form-control" type="number" step="0.001" min="0.001" asp-for="CreateInput.MaximumWeightKg" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Peso cúbico máx (kg)</label>
                            <input class="form-control" type="number" step="0.001" min="0" asp-for="CreateInput.MaximumCubicWeightKg" required />
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.SupportsFragileItems" />
                            <label class="form-check-label" asp-for="CreateInput.SupportsFragileItems">Aceita frágeis</label>
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.SupportsRestrictedItems" />
                            <label class="form-check-label" asp-for="CreateInput.SupportsRestrictedItems">Aceita restritos</label>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Dia da semana (opcional)</label>
                            <select class="form-select" asp-for="CreateInput.ScheduleDayOfWeek">
                                <option value="">-- nenhum --</option>
                                <option value="Sunday">Sunday</option>
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Horário de partida</label>
                            <input class="form-control" type="time" asp-for="CreateInput.ScheduleDepartureTime" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Criar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesAssets", "scripts")
    <script>
        $(function () {
            $('#lanes-table').DataTable({
                columnDefs: [{ targets: -1, orderable: false }],
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rt<"d-flex justify-content-between align-items-center mt-2"lp>',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });

            @if (Model.ShowCreateModal)
            {
                <text>
                var createLaneModal = new bootstrap.Modal(document.getElementById('createLaneModal'));
                createLaneModal.show();
                </text>
            }
        });
    </script>
}
