@page "/admin/orders"
@model Marketplace.Web.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Pedidos";
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-funnel me-1"></i> Buscar</div>
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-3">
                <label class="form-label small">Buyer ID</label>
                <input class="form-control" name="buyerId" value="@Model.BuyerId" />
            </div>
            <div class="col-3">
                <label class="form-label small">Seller ID</label>
                <input class="form-control" name="sellerId" value="@Model.SellerId" />
            </div>
            <div class="col-3">
                <label class="form-label small">Status</label>
                <input class="form-control" name="status" value="@Model.Status" placeholder="Confirmed, Cancelled..." />
            </div>
            <div class="col-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-receipt me-1"></i> Pedidos
        <span class="badge text-bg-secondary float-end">@Model.Orders.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Buyer</th>
                        <th>Seller</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Criado em</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><code>@order.Id</code></td>
                            <td><code>@order.BuyerId</code></td>
                            <td><code>@order.SellerId</code></td>
                            <td><span class="badge text-bg-light border">@order.Status</span></td>
                            <td>@order.Currency @order.TotalAmount</td>
                            <td>@order.CreatedAt</td>
                            <td><a asp-page="/Admin/Orders/Detail" asp-route-orderId="@order.Id">Detalhes</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
