@page "/admin/rate-cards"
@model Marketplace.Web.Pages.Admin.Pricing.RateCardsModel
@{
    ViewData["Title"] = "Admin - Rate Cards";
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="d-flex align-items-center justify-content-end mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRateCardModal">
        <i class="bi bi-plus-lg me-1"></i> Novo
    </button>
</div>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Código</th>
            <th>Carrier</th>
            <th>Service Level</th>
            <th>Moeda</th>
            <th>Status</th>
            <th class="text-end">Versão</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rc in Model.RateCards)
        {
            <tr>
                <td>@rc.Code</td>
                <td>@rc.CarrierCode</td>
                <td>@rc.ServiceLevelCode</td>
                <td>@rc.Currency</td>
                <td>@rc.Status</td>
                <td class="text-end">@rc.Version</td>
                <td>
                    <form method="post" asp-page-handler="Activate" class="d-inline">
                        <input type="hidden" name="rateCardId" value="@rc.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Activate</button>
                    </form>
                    <form method="post" asp-page-handler="Retire" class="d-inline">
                        <input type="hidden" name="rateCardId" value="@rc.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Retire</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createRateCardModal" tabindex="-1" aria-labelledby="createRateCardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createRateCardModalLabel">Criar Rate Card (com 1 item de tarifa)</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small">Código</label>
                            <input class="form-control" asp-for="CreateInput.Code" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Carrier Code</label>
                            <input class="form-control" asp-for="CreateInput.CarrierCode" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Service Level Code</label>
                            <input class="form-control" asp-for="CreateInput.ServiceLevelCode" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Moeda</label>
                            <input class="form-control" asp-for="CreateInput.Currency" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Vigência de</label>
                            <input class="form-control" type="datetime-local" asp-for="CreateInput.EffectiveFrom" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Vigência até</label>
                            <input class="form-control" type="datetime-local" asp-for="CreateInput.EffectiveUntil" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Origem (Node ID)</label>
                            <input class="form-control" asp-for="CreateInput.OriginNodeId" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Zona de destino</label>
                            <input class="form-control" asp-for="CreateInput.DestinationZone" required />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Peso mín (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.MinimumWeightKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Peso máx (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.MaximumWeightKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Preço base</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.BasePrice" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Peso incluso (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.IncludedWeightKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Incremento peso (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.WeightIncrementKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Preço/incremento</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.PricePerWeightIncrement" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">% Combustível</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.FuelSurchargePercentage" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Taxa área remota</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.RemoteAreaFee" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Taxa frágil</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.FragileFee" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Limiar oversize (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.OversizeThresholdKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Taxa oversize</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.OversizeFee" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Custo logístico mín</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.MinimumLogisticsCost" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Criar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            @if (Model.ShowCreateModal)
            {
                <text>
                var createRateCardModal = new bootstrap.Modal(document.getElementById('createRateCardModal'));
                createRateCardModal.show();
                </text>
            }
        });
    </script>
}
