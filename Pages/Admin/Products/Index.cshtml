@page "/admin/products"
@model Marketplace.Web.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Produtos Ofertados";
}

@section Styles {
    @await Html.PartialAsync("_DataTablesAssets", "styles")
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Produtos Ofertados</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
        <i class="bi bi-plus-lg me-1"></i> Novo produto
    </button>
</div>

<table id="products-table" class="table table-sm table-striped w-100">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Título</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.SkuId</td>
                <td>@product.Title</td>
                <td>@product.Category</td>
                <td data-order="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">@product.Price.ToString("C")</td>
                <td><span class="badge bg-secondary">@product.Status</span></td>
                <td>
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Products/Logistics" asp-route-skuId="@product.SkuId">
                            Logística
                        </a>
                        <form method="post" asp-page-handler="ChangeStatus" class="d-flex gap-1">
                            <input type="hidden" name="skuId" value="@product.SkuId" />
                            <select name="status" class="form-select form-select-sm">
                                <option value="Active" selected="@(product.Status == "Active")">Active</option>
                                <option value="Paused" selected="@(product.Status == "Paused")">Paused</option>
                                <option value="Blocked" selected="@(product.Status == "Blocked")">Blocked</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Alterar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createProductModalLabel">Criar produto</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">SKU ID</label>
                            <input class="form-control" asp-for="CreateInput.SkuId" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Seller ID</label>
                            <input class="form-control" asp-for="CreateInput.SellerId" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Título</label>
                            <input class="form-control" asp-for="CreateInput.Title" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Categoria</label>
                            <input class="form-control" asp-for="CreateInput.Category" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Preço</label>
                            <input class="form-control" type="number" step="0.01" asp-for="CreateInput.Price" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Peso (kg)</label>
                            <input class="form-control" type="number" step="0.001" asp-for="CreateInput.WeightKg" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Altura (cm)</label>
                            <input class="form-control" type="number" step="0.1" asp-for="CreateInput.HeightCm" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Largura (cm)</label>
                            <input class="form-control" type="number" step="0.1" asp-for="CreateInput.WidthCm" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small">Comprimento (cm)</label>
                            <input class="form-control" type="number" step="0.1" asp-for="CreateInput.LengthCm" />
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.IsFragile" />
                            <label class="form-check-label" asp-for="CreateInput.IsFragile">Frágil</label>
                        </div>
                        <div class="col-6 form-check ms-2 mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="CreateInput.IsRestricted" />
                            <label class="form-check-label" asp-for="CreateInput.IsRestricted">Restrito</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Criar produto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesAssets", "scripts")
    <script>
        $(function () {
            $('#products-table').DataTable({
                order: [[1, 'asc']],
                columnDefs: [{ targets: -1, orderable: false }],
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rt<"d-flex justify-content-between align-items-center mt-2"lp>',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });

            @if (Model.ShowCreateModal)
            {
                <text>
                var createProductModal = new bootstrap.Modal(document.getElementById('createProductModal'));
                createProductModal.show();
                </text>
            }
        });
    </script>
}
