@page "/admin/products/{skuId:guid}/logistics"
@model Marketplace.Web.Pages.Admin.Products.LogisticsModel
@{
    ViewData["Title"] = "Admin - Atributos Logísticos";
}

<div class="container py-4">
    <p class="text-uppercase text-muted fw-semibold mb-1">Administração · Catálogo</p>
    <h1 class="h3 mb-1">Atributos Logísticos</h1>
    <p class="text-muted">SKU @Model.SkuId @if (Model.Product is not null) { <text> · Seller @Model.Product.SellerId</text> }</p>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All"></div>
    }

    <div class="card" style="max-width: 480px;">
        <div class="card-body">
            <form method="post">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">Peso (kg)</label>
                        <input class="form-control" type="number" step="0.001" min="0.001" asp-for="Input.WeightKg" required />
                    </div>
                    <div class="col-6"></div>
                    <div class="col-4">
                        <label class="form-label small">Altura (cm)</label>
                        <input class="form-control" type="number" step="0.1" min="0.1" asp-for="Input.HeightCm" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label small">Largura (cm)</label>
                        <input class="form-control" type="number" step="0.1" min="0.1" asp-for="Input.WidthCm" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label small">Comprimento (cm)</label>
                        <input class="form-control" type="number" step="0.1" min="0.1" asp-for="Input.LengthCm" required />
                    </div>
                    <div class="col-6 form-check ms-2 mt-3">
                        <input class="form-check-input" type="checkbox" asp-for="Input.IsFragile" />
                        <label class="form-check-label" asp-for="Input.IsFragile">Frágil</label>
                    </div>
                    <div class="col-6 form-check ms-2 mt-3">
                        <input class="form-check-input" type="checkbox" asp-for="Input.IsRestricted" />
                        <label class="form-check-label" asp-for="Input.IsRestricted">Restrito</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3">Salvar</button>
                <a class="btn btn-link" asp-page="/Admin/Products/Index" asp-route-skuId="@Model.SkuId">Voltar</a>
            </form>
        </div>
    </div>
</div>
