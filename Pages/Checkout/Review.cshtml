@page
@model Marketplace.Web.Pages.Checkout.ReviewModel

@{
    ViewData["Title"] = "Revisar compra";
}

<div class="container py-4">
    <p class="marketplace-eyebrow mb-2">Checkout</p>
    <h1 class="h3 mb-4">Revise sua compra</h1>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="marketplace-card p-4">
                <h2 class="h5">Produtos</h2>

                @foreach (var item in Model.Checkout.Items)
                {
                    <div class="d-flex justify-content-between marketplace-list-item py-3">
                        <div>
                            <strong>SKU @item.SkuId</strong>
                            <div class="text-muted">Quantidade: @item.Quantity</div>
                        </div>
                    </div>
                }

                <h2 class="h5 mt-4">Entrega</h2>
                <div>@Model.Checkout.SelectedShipping.Mode</div>
                @if (Model.Checkout.SelectedShipping.EstimatedDeliveryDate is DateOnly estimatedDeliveryDate)
                {
                    <strong>Previsão: @estimatedDeliveryDate.ToString("dd/MM/yyyy")</strong>
                }
            </section>
        </div>

        <div class="col-lg-4">
            <section class="marketplace-card p-4">
                <h2 class="h5">Resumo</h2>

                <div class="d-flex justify-content-between">
                    <span>Produtos</span>
                    <span>@Model.Checkout.ItemsTotal.ToString("C")</span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Frete</span>
                    <span>@Model.Checkout.ShippingPrice.ToString("C")</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between h5">
                    <span>Total</span>
                    <span>@Model.Checkout.TotalAmount.ToString("C")</span>
                </div>

                <form method="post" asp-page-handler="Confirm">
                    <input asp-for="Input.CheckoutId" type="hidden" />
                    <input asp-for="Input.IdempotencyKey" type="hidden" />
                    <input asp-for="Input.PaymentIntentId" type="hidden" />

                    <button type="submit" data-loading-text="Confirmando compra..." class="btn btn-success btn-lg w-100">Confirmar compra</button>
                </form>
            </section>
        </div>
    </div>
</div>
