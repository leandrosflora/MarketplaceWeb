@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<div class="container py-4">
    @if (Model.FeaturedProducts.Count > 0)
    {
        <div id="offersCarousel" class="carousel slide marketplace-card offers-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.FeaturedProducts.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#offersCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Oferta @(i + 1)"></button>
                }
            </div>

            <div class="carousel-inner">
                @for (var i = 0; i < Model.FeaturedProducts.Count; i++)
                {
                    var product = Model.FeaturedProducts[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="offer-slide">
                            <div class="offer-slide-media">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Title"
                                         class="offer-slide-image"
                                         onerror="this.style.display='none'" />
                                }
                            </div>
                            <div class="offer-slide-info">
                                <p class="marketplace-eyebrow mb-2">Oferta em destaque</p>
                                <h1 class="h3 mb-2">@product.Title</h1>
                                <div class="product-price mb-3">@product.Price.ToString("C")</div>
                                <a asp-page="/Products/Details"
                                   asp-route-id="@product.SkuId"
                                   class="btn btn-primary">
                                    Ver oferta
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.FeaturedProducts.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#offersCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#offersCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Próxima</span>
                </button>
            }
        </div>
    }

    <div id="product-grid">
        @await Html.PartialAsync("_ProductGridPartial", Model)
    </div>
</div>
