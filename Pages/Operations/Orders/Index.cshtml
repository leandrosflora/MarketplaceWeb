@page "/operations/orders"
@model Marketplace.Web.Pages.Operations.Orders.IndexModel
@{
    ViewData["Title"] = "Order Monitor";
    ViewData["JaegerBaseUrl"] = Model.JaegerBaseUrl;
}

<div class="container py-4" data-jaeger-base-url="@Model.JaegerBaseUrl">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <p class="text-uppercase text-muted fw-semibold mb-1">Operações</p>
            <h1 class="h3 mb-0">Order Monitor</h1>
        </div>
        <span class="text-muted small">Atualiza automaticamente a cada 4s · última atualização: <span id="last-refresh">-</span></span>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label small mb-1">Status</label>
            <input class="form-control form-control-sm" name="Status" value="@Model.Status" placeholder="ex: PaymentRejected" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Order ID</label>
            <input class="form-control form-control-sm" name="OrderId" value="@Model.OrderId" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Checkout ID</label>
            <input class="form-control form-control-sm" name="CheckoutId" value="@Model.CheckoutId" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Correlation ID</label>
            <input class="form-control form-control-sm" name="CorrelationId" value="@Model.CorrelationId" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Buyer ID</label>
            <input class="form-control form-control-sm" name="BuyerId" value="@Model.BuyerId" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Seller ID</label>
            <input class="form-control form-control-sm" name="SellerId" value="@Model.SellerId" />
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" class="form-check-input" id="HasError" name="HasError" value="true" checked="@(Model.HasError == true)" />
            <label class="form-check-label small" for="HasError">Somente com erro</label>
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" class="form-check-input" id="StuckOnly" name="StuckOnly" value="true" checked="@(Model.StuckOnly == true)" />
            <label class="form-check-label small" for="StuckOnly">Somente travados</label>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
            <a href="/operations/orders" class="btn btn-sm btn-outline-secondary">Limpar</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle" id="journeys-table">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Checkout</th>
                    <th>Status</th>
                    <th>Etapa atual</th>
                    <th>Último evento</th>
                    <th>Tempo parado</th>
                    <th>Erro</th>
                    <th>Correlation ID</th>
                    <th>Trace</th>
                    <th>Atualizado em</th>
                </tr>
            </thead>
            <tbody id="journeys-tbody">
                @foreach (var journey in Model.Journeys)
                {
                    <partial name="_JourneyRow" model="journey" />
                }
            </tbody>
        </table>

        @if (Model.Journeys.Count == 0)
        {
            <div class="text-muted text-center py-4">Nenhuma jornada encontrada para os filtros informados.</div>
        }
    </div>
</div>

<script src="~/js/order-monitor.js" asp-append-version="true"></script>
