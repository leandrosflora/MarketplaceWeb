@page
@model Marketplace.Web.Pages.SearchModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
        ? "Buscar produtos"
        : $"Busca por {Model.Query}";
}

<div class="container py-4">
    <section class="marketplace-card marketplace-hero p-4 p-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="marketplace-eyebrow mb-2">Busca</p>
                <h1 class="h2 mb-3">Buscar produtos</h1>

                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <p class="lead mb-0">
                        Digite o nome, categoria ou SKU do produto para consultar o catálogo pelo BFF.
                    </p>
                }
                else
                {
                    <p class="lead mb-0">
                        Você pesquisou por <strong>@Model.Query</strong>.
                    </p>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-4" role="alert">
            Não foi possível buscar produtos agora. @Model.ErrorMessage
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <section class="mt-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h4 mb-0">Resultados</h2>
                <span class="text-muted">@Model.Products.Count produto(s)</span>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="marketplace-card p-4 text-center text-muted">
                    Nenhum produto encontrado para a busca informada.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-md-6 col-xl-4">
                            <article class="marketplace-card product-search-card h-100 p-4">
                                <div class="text-muted small mb-2">@product.Category</div>
                                <h3 class="h5 mb-3">
                                    <a asp-page="/Products/Details"
                                       asp-route-id="@product.SkuId"
                                       class="stretched-link text-decoration-none">
                                        @product.Title
                                    </a>
                                </h3>
                                <div class="product-search-price mb-3">@product.Price.ToString("C")</div>
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    @if (product.AvailableForSale)
                                    {
                                        <span class="badge text-bg-success">Disponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">@product.Status</span>
                                    }

                                    @if (product.Score is not null)
                                    {
                                        <span class="text-muted small">Score @product.Score.Value.ToString("0.##")</span>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>
