@page
@model Marketplace.Web.Pages.SearchModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
        ? "Buscar produtos"
        : $"Busca por {Model.Query}";
}

<div class="container py-4">
    <section class="marketplace-card p-4 p-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="text-uppercase text-muted fw-semibold mb-2">Busca</p>
                <h1 class="h2 mb-3">Buscar produtos</h1>

                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <p class="lead mb-4">
                        Digite o SKU do produto no campo de busca para abrir a página de detalhes.
                    </p>

                    <div class="alert alert-info mb-0" role="status">
                        A busca por texto ainda não está disponível porque o BFF expõe apenas consultas por SKU.
                    </div>
                }
                else
                {
                    <p class="lead mb-4">
                        Você pesquisou por <strong>@Model.Query</strong>.
                    </p>

                    <div class="alert alert-warning mb-0" role="status">
                        Ainda não é possível listar produtos pelo termo pesquisado porque o BFF não expõe um endpoint
                        de busca de catálogo. Para abrir um produto diretamente, pesquise pelo SKU em formato GUID.
                    </div>
                }
            </div>
        </div>
    </section>
</div>
