@page
@model Marketplace.Web.Pages.SearchModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
        ? "Buscar produtos"
        : $"Busca por {Model.Query}";
}

<div class="container py-4">
    <section class="marketplace-card marketplace-hero p-4 p-md-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="marketplace-eyebrow mb-2">Busca</p>
                <h1 class="h2 mb-3">Buscar produtos</h1>

                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <p class="lead mb-0">
                        Digite o nome, categoria ou SKU do produto para consultar o catálogo pelo BFF.
                    </p>
                }
                else
                {
                    <p class="lead mb-0">
                        Você pesquisou por <strong>@Model.Query</strong>.
                    </p>
                }
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-4" role="alert">
            Não foi possível buscar produtos agora. @Model.ErrorMessage
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <section class="mt-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h4 mb-0">Resultados</h2>
                <span class="text-muted">@Model.Products.Count produto(s)</span>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="marketplace-card p-4 text-center text-muted">
                    Nenhum produto encontrado para a busca informada.
                </div>
            }
            else
            {
                <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col">
                            <article class="marketplace-card product-search-card h-100 p-2">
                                <div class="product-search-thumb mb-2">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Title"
                                             class="product-search-image"
                                             onerror="this.replaceWith(Object.assign(document.createElement('div'), { className: 'product-search-image-placeholder', innerHTML: '&lt;span&gt;Sem imagem&lt;/span&gt;' }))" />
                                    }
                                    else
                                    {
                                        <div class="product-search-image-placeholder"><span>Sem imagem</span></div>
                                    }
                                </div>
                                <div class="text-muted small mb-1">@product.Category</div>
                                <h3 class="product-search-title mb-1">
                                    <a asp-page="/Products/Details"
                                       asp-route-id="@product.SkuId"
                                       class="stretched-link text-decoration-none">
                                        @product.Title
                                    </a>
                                </h3>
                                <div class="product-search-price mb-1">@product.Price.ToString("C")</div>
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    @if (product.AvailableForSale)
                                    {
                                        <span class="badge bg-success">Disponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@product.Status</span>
                                    }

                                    @if (product.Score is not null)
                                    {
                                        <span class="text-muted small">Score @product.Score.Value.ToString("0.##")</span>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>
