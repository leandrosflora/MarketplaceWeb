@using Marketplace.Web.Clients
@using Marketplace.Web.Infrastructure.Cart
@inject IMarketplaceBffClient BffClient
@inject ICartOwnerIdAccessor CartOwnerIdAccessor
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketPlace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketplaceWeb.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="marketplace-header">
        <div class="container py-3">
            <div class="d-flex align-items-center gap-3 marketplace-header-row">
                <a asp-page="/Index" class="marketplace-logo flex-shrink-0">MarketPlace</a>

                <form method="get" asp-page="/Search" class="marketplace-search-form">
                    <div class="input-group">
                        <input type="search" name="query" value='@Context.Request.Query["query"]' class="form-control" placeholder="Buscar produtos" />
                        <button class="btn btn-light" type="submit" data-loading-text="Buscando...">Buscar</button>
                    </div>
                </form>

                <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                    <a asp-page="/Cart/Index" class="btn btn-outline-light position-relative" title="Carrinho" aria-label="Carrinho">
                        <i class="bi bi-cart3"></i>
                        @{
                            var cartItemCount = await GetCartItemCountAsync();
                        }
                        @if (cartItemCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@cartItemCount</span>
                        }
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Orders/Index" class="btn btn-outline-light" title="Meus pedidos" aria-label="Meus pedidos">
                            <i class="bi bi-box-seam"></i>
                        </a>
                        <a asp-page="/Admin/Index" class="btn btn-outline-light" title="Admin" aria-label="Admin">
                            <i class="bi bi-speedometer2"></i>
                        </a>
                        <span class="text-white small">@User.Identity.Name</span>
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-light btn-sm" title="Sair" aria-label="Sair" data-loading-text="Saindo...">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-light btn-sm" title="Entrar" aria-label="Entrar">
                            <i class="bi bi-box-arrow-in-right"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MarketPlace
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private async Task<int> GetCartItemCountAsync()
    {
        var cartOwnerId = User.Identity?.IsAuthenticated == true
            ? CartOwnerIdAccessor.GetOrCreateCartOwnerId(Context)
            : CartOwnerIdAccessor.TryGetAnonymousCartOwnerId(Context);

        if (cartOwnerId is null)
        {
            return 0;
        }

        try
        {
            var cart = await BffClient.GetCartAsync(cartOwnerId, Context.RequestAborted);
            return cart.TotalItemCount;
        }
        catch
        {
            return 0;
        }
    }
}
